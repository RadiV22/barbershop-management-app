# Server backend
PORT=3000

# PostgreSQL lokal — sesuaikan username, password, dan nama database
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@localhost:5432/barbershop_db

# Ganti dengan secret acak yang kuat pada file .env
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Akun admin untuk proses seed
ADMIN_NAME=Admin Barbershop
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Midtrans Sandbox
MIDTRANS_SERVER_KEY=REPLACE_WITH_YOUR_SANDBOX_SERVER_KEY
MIDTRANS_IS_PRODUCTION=false